#!/command/with-contenv sh

set -eu

mkdir -p /var/log/mc
cd /mc/backend

case "${MC_SERVICE_TYPE:-mc_bd}" in
  mc_bd)
    exec >>/var/log/mc/mc_bd.log 2>&1
    exec /usr/local/bin/granian main:app \
      --interface asgi \
      --host 0.0.0.0 \
      --port 8001 \
      --workers 1 \
      --backlog 1024 \
      --workers-kill-timeout 120 \
      --backpressure 2000 \
      --pid-file /var/run/granian.pid \
      --log \
      --log-level debug
    ;;
  mc_celery_worker)
    exec >>/var/log/mc/mc_celery_worker.log 2>&1
    exec /usr/local/bin/celery -A app.task.celery worker -P gevent -c 1000 --loglevel=INFO
    ;;
  mc_celery_beat)
    exec >>/var/log/mc/mc_celery_beat.log 2>&1
    exec /usr/local/bin/celery -A app.task.celery beat --loglevel=INFO
    ;;
  mc_celery_flower)
    exec >>/var/log/mc/mc_celery_flower.log 2>&1
    exec /usr/local/bin/celery -A app.task.celery flower --port=8555 --url-prefix=flower --basic-auth=admin:123456
    ;;
  *)
    echo "Unknown MC_SERVICE_TYPE: ${MC_SERVICE_TYPE}" >&2
    exit 1
    ;;
esac
